[
  {
    "plugin_id": "local.tab-numbers",
    "name": "Tab numbers",
    "version": "0.1.0",
    "min_herdr_version": "0.9.0",
    "description": "Prefix every tab label with its position, so labels match prefix+1..9",
    "manifest_path": "/Users/brpol/.config/herdr/plugins/tab-numbers/herdr-plugin.toml",
    "plugin_root": "/Users/brpol/.config/herdr/plugins/tab-numbers",
    "enabled": true,
    "platforms": [
      "linux",
      "macos"
    ],
    "startup": [
      {
        "command": [
          "sh",
          "number-tabs.sh"
        ]
      }
    ],
    "events": [
      {
        "on": "tab.closed",
        "command": [
          "sh",
          "number-tabs.sh"
        ]
      },
      {
        "on": "tab.created",
        "command": [
          "sh",
          "number-tabs.sh"
        ]
      },
      {
        "on": "tab.moved",
        "command": [
          "sh",
          "number-tabs.sh"
        ]
      },
      {
        "on": "tab.renamed",
        "command": [
          "sh",
          "number-tabs.sh"
        ]
      }
    ],
    "source": {
      "kind": "local"
    }
  }
]